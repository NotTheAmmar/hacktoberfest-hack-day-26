{
  "manifest_version": 3,
  "name": "Local Whisper Paperwork",
  "version": "0.2.0",
  "description": "Voice-guided AI form-filling assistant powered by Whisper + Gemma 4. Scrapes Google Forms, records audio, and autofills answers directly.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://*.ngrok-free.app/*",
    "https://docs.google.com/*",
    "https://forms.gle/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Local Whisper Paperwork",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://forms.gle/*"
      ],
      "js": ["content/extractor.js", "content/filler.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content/panel.css"],
      "matches": [
        "https://docs.google.com/*",
        "https://forms.gle/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
