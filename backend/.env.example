# ──────────────────────────────────────────────────────────────────────────────
# Local Whisper Paperwork — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git (it's in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ngrok URL of your Kaggle notebook running Gemma 2 inference
# Example: https://xxxx-xx-xx-xxx-xxx.ngrok-free.app
GEMMA_API_URL=https://your-ngrok-url.ngrok-free.app

# Gemma 2 model endpoint path (relative to GEMMA_API_URL)
# If your Kaggle notebook uses /generate, set this to /generate
# If it's OpenAI-compatible, set to /v1/chat/completions
GEMMA_ENDPOINT=/v1/chat/completions

# Whisper model size: tiny | base | small | medium | large-v3
# 'base' is recommended for hackathon use (fast, ~140MB)
WHISPER_MODEL=base

# Whisper device: cpu | cuda (use cuda if you have an NVIDIA GPU locally)
WHISPER_DEVICE=cpu

# Whisper compute type: int8 | float16 | float32
# int8 is fastest on CPU; float16 is best on GPU
WHISPER_COMPUTE_TYPE=int8

# Backend port
PORT=8000
