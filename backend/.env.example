# ──────────────────────────────────────────────────────────────────────────────
# Local Whisper Paperwork — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git (it's in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ngrok URL of your Kaggle notebook running Gemma 4 & Whisper inference
# Example: https://xxxx-xx-xx-xxx-xxx.ngrok-free.app
GEMMA_API_URL=https://your-ngrok-url.ngrok-free.app

# Gemma 4 model endpoint path (relative to GEMMA_API_URL)
# If using Kaggle standard schema:
#   POST /api/v1/parse-fields
#   POST /api/v1/process-audio
# Or if using OpenAI-compatible chat server:
#   POST /v1/chat/completions
GEMMA_ENDPOINT=/v1/chat/completions

# Local Faster-Whisper settings (used for local STT fallback)
# Model sizes: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local backend port
PORT=8000
